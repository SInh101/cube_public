{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/cubes/:cubeId/commutators",
      "destination": "/api/cubes?cubeId=:cubeId&operation=commutator"
    },
    {
      "source": "/api/presets/:presetId",
      "destination": "/api/presets?presetId=:presetId"
    },
    {
      "source": "/api/cubes/:cubeId/reset",
      "destination": "/api/cubes?cubeId=:cubeId&operation=reset"
    },
    {
      "source": "/api/cubes/:cubeId",
      "destination": "/api/cubes?cubeId=:cubeId"
    }
  ]
}
