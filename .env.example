# Browser-visible base URL of the deployed REST API (no trailing slash).
# Leave empty when web and API share an origin.
VITE_API_BASE_URL=

# REST API server only. Never expose the service role key through VITE_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Set this to the exact GitHub Pages origin in Vercel.
# Example: https://OWNER.github.io
CORS_ALLOWED_ORIGIN=
